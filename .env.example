# ============================================================
# .env.example — Konfigurasi Lingkungan (Environment Variables)
# ============================================================
#
# CARA PENGGUNAAN:
#   1. Salin berkas ini ke .env: cp .env.example .env
#   2. Isi token bot dan chat ID Anda di bawah ini
#
# PENTING: Jangan pernah commit berkas .env ke GitHub!
# ============================================================

# Token Bot Telegram (dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=isi_token_bot_anda_di_sini

# Chat ID tujuan notifikasi (diisi setelah menjalankan program)
TELEGRAM_CHAT_ID=isi_telegram_chat_id
